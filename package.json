{
  "name": "@magadhtech/ui",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dayjs": "1.11.13",
    "lucide-react": "^0.561.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": ">=0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./*.css": "./dist/*.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "description": "A compact React UI kit for data-heavy consoles: list pages, dense tables, toolbars, filters, panels, pickers and a file viewer, styled by CSS variables.",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/copy-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "bun scripts/size.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  }
}
