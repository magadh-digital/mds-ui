{
  "name": "@mds/ui",
  "version": "0.3.0",
  "description": "A light React UI kit for data-heavy apps: dense tables, toolbars, filters, side panels, pickers, a date range, a file viewer, an app shell and \u2318K palette. Plain CSS variables; React is the only peer.",
  "license": "MIT",
  "author": "MagadhTech",
  "homepage": "https://github.com/MagadhTech/mds-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagadhTech/mds-ui.git"
  },
  "bugs": {
    "url": "https://github.com/MagadhTech/mds-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "table",
    "data-table",
    "datepicker",
    "autocomplete",
    "combobox",
    "admin",
    "dashboard",
    "floating-ui",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dayjs": "1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/copy-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "bun scripts/size.ts",
    "bench": "sh bench/run.sh",
    "check": "bun run typecheck && bun test src && bun run build && bun scripts/size.ts --check"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": ">=0.500.0 <1.0.0"
  }
}
