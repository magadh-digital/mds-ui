{
  "name": "@magadhtech/ui",
  "version": "0.1.0",
  "description": "A compact React UI kit for data-heavy consoles: list pages, dense tables, toolbars, filters, panels, pickers and a file viewer, styled by CSS variables.",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./*.css": "./dist/*.css",
    "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js" }
  },
  "files": ["dist", "README.md", "AGENTS.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/copy-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "size": "bun scripts/size.ts"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.31.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": ">=0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": { "optional": true }
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "react-datepicker": "^9.1.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
